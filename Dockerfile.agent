FROM debian:trixie-slim


# An agent must not be newer than its manager, so keep this at or below the manager's version.
ARG WAZUH_VERSION=4.14.0-1
LABEL version="${WAZUH_VERSION}"
LABEL description="Wazuh Agent"


COPY bin/entrypoint_node.sh /entrypoint.sh
COPY config/ossec_node.tpl /opt/ossec/ossec.tpl

#Install pre
RUN apt-get update && apt-get install -y python3 python3-pip  --no-install-recommends && apt-get clean \
&& rm -rf /var/lib/apt/lists/*

#Install pyton packages for wazuh
RUN pip3 install --no-cache-dir boto3 pyarrow numpy --break-system-packages
RUN pip3 install fastapi[standard] uvicorn --break-system-packages


RUN apt-get update && apt-get install -y  procps curl apt-transport-https ca-certificates gnupg2 inotify-tools gettext-base --no-install-recommends && apt-get clean \
&& rm -rf /var/lib/apt/lists/*



#Install wazuh
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import && chmod 644 /usr/share/keyrings/wazuh.gpg
RUN echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" | tee -a /etc/apt/sources.list.d/wazuh.list 


RUN apt-get update && apt-get install -y "wazuh-agent=${WAZUH_VERSION}" --no-install-recommends && apt-get clean \
&& rm -rf /var/lib/apt/lists/*

# osquery, run by the agent's osquery module when OSQUERY_DISABLED=no. Its
# results go to the manager over the normal agent connection (Wazuh rule 24010).
# The build fails unless the repo key is osquery's published signing key.
ARG OSQUERY_VERSION=5.24.1-1.linux
ARG OSQUERY_KEY_FPR=1484120AC4E9F8A1A577AEEE97A80C63C9D8B80B
RUN curl -fsSL https://pkg.osquery.io/deb/pubkey.gpg | gpg --dearmor -o /usr/share/keyrings/osquery.gpg \
 && gpg --show-keys --with-colons /usr/share/keyrings/osquery.gpg | grep -q "^fpr:::::::::${OSQUERY_KEY_FPR}:" \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/osquery.gpg] https://pkg.osquery.io/deb deb main" > /etc/apt/sources.list.d/osquery.list \
 && apt-get update && apt-get install -y "osquery=${OSQUERY_VERSION}" --no-install-recommends && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
COPY config/osquery.conf /etc/osquery/osquery.conf



#Adding Webserver and ready, metrics 
COPY web /web
RUN chmod +x /web/ready.sh &&  chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
